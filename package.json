{
  "name": "@prometheus-harness/root",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Prometheus Harness — Bun-Arbeitsbereich für den TypeScript-Backend-Kern (Typecheck mit TypeScript 7, Ausführung mit Bun)",
  "workspaces": [
    "packages/*/*",
    "apps/web",
    "apps/cli"
  ],
  "scripts": {
    "typecheck": "bun run scripts/typecheck.mjs",
    "build": "bun run scripts/typecheck.mjs",
    "check:readme": "bun run scripts/readme-paarung.mjs",
    "bench": "bun run benchmarks/lauf.mjs",
    "test": "bun test",
    "install:alles": "bun run scripts/install.mjs",
    "start": "bun run scripts/start.mjs",
    "start:web": "bun run scripts/start.mjs --no-go",
    "start:go": "bun run scripts/start.mjs --no-host",
    "migrate": "bun run scripts/migrate.mjs",
    "lint": "echo \"lint: noch nicht verdrahtet — es ist kein Linter konfiguriert (siehe docs/backend-ts.md)\""
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "postgres": "^3.4.9"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}

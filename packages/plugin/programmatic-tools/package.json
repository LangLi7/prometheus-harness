{
  "name": "@prometheus-harness/programmatic-tools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ein zusammengesetztes Werkzeug: native Werkzeuge bleiben sichtbar, run_program buendelt sie in einem Sandkasten-Programm. Der Hybride zwischen Standardmodus und PTC.",
  "main": "src/server.ts",
  "exports": {
    ".": "./src/server.ts",
    "./cordis.patch.yml": "./cordis.patch.yml",

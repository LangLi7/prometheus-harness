{
  "name": "@prometheus-harness/accounts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Konten als eigenes DSH-Plugin: ein Sidebar-Eintrag, ein main-Panel mit Benutzerliste (Rolle, Zustand) und Einladungen mit Ablauf. Die Wege liegen in @prometheus-harness/auth-http (/api/pmh/auth/benutzer, /api/pmh/auth/einladungen).",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "bun run build.mjs",
    "typecheck": "tsgo --noEmit -p tsconfig.json"
  }
}
